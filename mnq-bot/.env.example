# IMPORTANT: Copy this file to .env and fill in your real values.
# NEVER commit .env to version control — it is gitignored for your protection.
# If you accidentally expose secrets, revoke and rotate them immediately.
#
# Copy to `.env` and fill in your own values.
# `.env` is gitignored; this template is safe to commit.

# ── TradingView ──────────────────────────────────────────────────────────────
TV_USERNAME=your_email@example.com
TV_PASSWORD=your_tradingview_password

# ── Tradovate ────────────────────────────────────────────────────────────────
TRADOVATE_USERNAME=
TRADOVATE_PASSWORD=
TRADOVATE_APP_ID=Sample App
TRADOVATE_APP_VERSION=1.0
TRADOVATE_CID=0
TRADOVATE_SECRET=

# ── Live / Demo Switch ───────────────────────────────────────────────────────
# Set true ONLY when you are ready to trade real money.
LIVE_TRADING=false

# ── Databento ────────────────────────────────────────────────────────────────
DATABENTO_API_KEY=db-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ── TopStepX / ProjectX ──────────────────────────────────────────────────────
# TopStep's modern broker API. Generate the API key inside your TopStepX
# platform settings; PROJECTX_USERNAME is your TopStepX login.
# Use the demo gateway for paper trading; flip to api.topstepx.com for live.
PROJECTX_USERNAME=
PROJECTX_API_KEY=
PROJECTX_GATEWAY=https://api.topstepx.com
